GEMINI_API_KEY=your_google_ai_studio_key_here

# Firebase Admin SDK (server-side only — NEVER expose these client-side)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# Firebase Client SDK (safe to expose — VITE_ prefix only, Vite controls what's in the browser bundle)
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Cloudinary — Image Storage (FREE, no credit card required)
# Sign up at cloudinary.com, then: Settings → Upload → Upload Presets → Add unsigned preset
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset_name

# Municipal Worker Passphrase (controls persona switch in UI)
MUNICIPAL_WORKER_PASSPHRASE=civix2026

#carto map api
VITE_CARTO_BASEMAP_KEY=your_carto_api_key

# Runtime
NODE_ENV=development
PORT=3001
